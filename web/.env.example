# Which network and contracts the app talks to.
NEXT_PUBLIC_NETWORK=testnet
NEXT_PUBLIC_CONTRACT=cmt.fatneek-committee.testnet
NEXT_PUBLIC_TOKEN=usd.fatneek-committee.testnet
# Comma-separated RPC endpoints, tried in order.
NEXT_PUBLIC_RPC=https://rpc.testnet.near.org,https://test.rpc.fastnear.com
# Link shown in the footer.
NEXT_PUBLIC_REPO_URL=

# Server only: the three demo members and their keys (testnet only).
# Generated by ../scripts/setup-demo.ps1 into .env.local.
DEMO_ACCOUNTS='[]'
